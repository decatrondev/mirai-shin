<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Image, Video y Mode los escribe el daemon. Image: file:// del cuadro fijo de esta pantalla. -->
    <entry name="Image" type="String">
      <default></default>
    </entry>
    <!-- Video: file:// del video que se reproduce aquí (vacío si es una imagen). -->
    <entry name="Video" type="String">
      <default></default>
    </entry>
    <!-- Mode: encuadre del video (fill, fit, stretch, center). -->
    <entry name="Mode" type="String">
      <default>fill</default>
    </entry>
    <!-- Status: lo escribe el complemento para el daemon (loading, playing o código del problema). -->
    <entry name="Status" type="String">
      <default></default>
    </entry>
    <!-- Paused: "true" = el video queda en pausa en su último cuadro (fase 3). -->
    <entry name="Paused" type="String">
      <default></default>
    </entry>
    <!-- PauseWhen: con qué ventanas encima se pausa solo ("fullscreen", "maximized", las dos o vacío; fase 3.3). -->
    <entry name="PauseWhen" type="String">
      <default></default>
    </entry>
    <!-- Covered: lo escribe el complemento: por qué ventana está en pausa ("fullscreen", "maximized" o vacío). -->
    <entry name="Covered" type="String">
      <default></default>
    </entry>
    <!-- Fps: cuadros por segundo que llegan a la pantalla / los del video (p. ej. 29.8/30.0). -->
    <entry name="Fps" type="String">
      <default></default>
    </entry>
  </group>
</kcfg>
